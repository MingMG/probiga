# 复制为 .env 后按需填写（勿将含密钥的 .env 提交到 git）

# 可选：SQLAlchemy 连接串。开发可用 SQLite，例如：
# DATABASE_URL=sqlite:///./data/probiga.db
# 生产可改为 PostgreSQL 等
DATABASE_URL=

# STOCK-INFO 同步脚本（biz/stock_info/sync_stock_info.py）示例
# MYSQL_URL=mysql+pymysql://root:123456@localhost:3306/probiga?charset=utf8mb4

# 企微群机器人 Webhook 完整 URL（含 key）
# 文档：https://developer.work.weixin.qq.com/document/path/91770
WECOM_WEBHOOK_URL=

# DeepSeek 官方 API Key，用于 AI 查询和股票分析
DEEPSEEK_API_KEY=
# 可选：默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
