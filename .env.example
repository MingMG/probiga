# 复制为 .env 后按需填写（勿将含密钥的 .env 提交到 git）

# MySQL 连接串。平台 API、采集脚本、复盘、推荐和模拟交易统一使用它。
# 示例：MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/probiga?charset=utf8mb4
MYSQL_URL=

# Optional: stock-minute data can live in another MySQL instance.
# Example for production reading a workstation through an SSH tunnel:
# MINUTE_MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:13306/probiga?charset=utf8mb4
# MINUTE_DATA_SOURCE=gm
# MINUTE_STOCK_TABLE=sm_stock_minute_gm
MINUTE_MYSQL_URL=
MINUTE_DATA_SOURCE=legacy
MINUTE_STOCK_TABLE=

# 可选：兼容旧配置名；未配置 MYSQL_URL 时才会使用 DATABASE_URL。
DATABASE_URL=

# 小机器建议保守一些：API 默认只保留 3 个常驻连接，额外溢出 1 个。
API_MYSQL_POOL_SIZE=3
API_MYSQL_MAX_OVERFLOW=1
API_MYSQL_POOL_RECYCLE=1800

# 分钟线读库可再小一些，避免与主 API 抢连接。
MINUTE_MYSQL_POOL_SIZE=2
MINUTE_MYSQL_MAX_OVERFLOW=1
MINUTE_MYSQL_POOL_RECYCLE=1800

# 内嵌调度默认关闭，避免 API 进程在 2核2G 机器上同时扛接口和任务。
# 如果你希望 API 进程直接带调度，再改成 true。
API_EMBEDDED_SCHEDULER_ENABLED=false
API_SCHEDULER_MAX_CONCURRENT_TASKS=1
API_SCHEDULER_POLL_SECONDS=60
# 推荐把调度独立跑成单独进程：
#   python tools/run_scheduler_daemon.py

# 企微群机器人 Webhook 完整 URL（含 key）。未单独配置时，新闻/早晚报都会回退到这个地址。
# 文档：https://developer.work.weixin.qq.com/document/path/91770
WECOM_WEBHOOK_URL=
# 可选：实时重要快讯机器人
WECOM_NEWS_WEBHOOK_URL=
# 可选：早报、晚报、周报机器人
WECOM_BRIEFING_WEBHOOK_URL=

# DeepSeek 官方 API Key，用于 AI 查询和股票分析
DEEPSEEK_API_KEY=
# 可选：默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# ===== 数据源配置（统一 registry 管理）=====
# 每种数据类型可独立指定数据源。支持的值：adata（默认）、akshare、myquant、qmt
# 向后兼容：旧的 SM_STOCK_*_SOURCE 环境变量仍然生效。
# SM_STOCK_KLINE_SOURCE=adata
# SM_STOCK_MINUTE_SOURCE=adata
# SM_STOCK_CURRENT_SOURCE=adata
# SM_MARKET_DATA_SOURCE=  # 旧写法，同时作为 minute/current 的 fallback

# ===== MyQuant / Goldminer =====
# GM_TOKEN=
# MYQUANT_PYTHON=  # 可选：指向 Python 3.6 运行时
# MYQUANT_TIMEOUT=120

# ===== JoinQuant / JQData =====
JQ_PHONE=
JQ_PASSWORD=

# ===== QMT / xtquant (迅投极速交易终端) =====
# 需要先启动 QMT 客户端并登录，然后以 miniQMT 模式运行
# 使用方式：SM_STOCK_KLINE_SOURCE=qmt
# QMT_PYTHON=  # 可选：指定 xtquant 所在的 Python 路径
