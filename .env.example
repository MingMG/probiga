# Copy to `.env` and fill in the values you actually use.
# Do not commit secrets.

# Primary MySQL connection used by data jobs and the API.
# Example:
# MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/probiga?charset=utf8mb4
MYSQL_URL=

# MySQL runtime TLS. Keep TLS material outside MYSQL_URL so individual jobs
# cannot weaken verification with URL query parameters. The formal MySQL 8.4
# runtime must set both values; leave both empty/false only during the temporary
# legacy MySQL 5.5 rollback window.
MYSQL_TLS_REQUIRED=false
# Example: D:\MySQL84\certs\ca.pem
MYSQL_SSL_CA=

# Optional: stock-minute history can live in another MySQL instance.
# Example:
# MINUTE_MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:13306/probiga?charset=utf8mb4
# QMT history is bigger; point this to a local/off-production MySQL database.
# QMT_HISTORY_MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:13306/probiga_qmt_history?charset=utf8mb4
# MINUTE_DATA_SOURCE=gm
# MINUTE_STOCK_TABLE=sm_stock_minute_gm
QMT_HISTORY_MYSQL_URL=
MINUTE_MYSQL_URL=
MINUTE_DATA_SOURCE=legacy
MINUTE_STOCK_TABLE=

# Legacy fallback if MYSQL_URL is unset.
DATABASE_URL=

# API MySQL pool.
API_MYSQL_POOL_SIZE=3
API_MYSQL_MAX_OVERFLOW=1
API_MYSQL_POOL_RECYCLE=1800

# API observability.
# 0 disables slow-request warning logs while keeping response timing headers.
API_SLOW_REQUEST_MS=1500
API_SLOW_SQL_MS=500
API_CACHE_MAX_ENTRIES=512

# Admin API protection. Mutating API calls plus scheduler/deploy/datasource
# management routes require this token when protection is enabled.
PROBIGA_ADMIN_AUTH_ENABLED=true
PROBIGA_ADMIN_TOKEN=

# Production release identity.  Deployment supplies these values from the
# pinned main commit and the independently pinned, read-only adata source.
# Do not point PROBIGA_ADATA_SOURCE_DIR at this repository's mutable adata/ checkout.
PROBIGA_DEPLOYMENT_MODE=development
PROBIGA_EXPECTED_GIT_SHA=
PROBIGA_EXPECTED_ADATA_SHA=
PROBIGA_EXPECTED_ADATA_TREE_SHA256=
PROBIGA_ADATA_SOURCE_DIR=
# 登录会话每 24 小时轮换；生产启用 HTTPS 后将 COOKIE_SECURE 设为 true。
PROBIGA_AUTH_SESSION_HOURS=24
PROBIGA_AUTH_REFRESH_AFTER_HOURS=20
PROBIGA_AUTH_MAX_FAILURES=5
PROBIGA_AUTH_LOCK_MINUTES=15
PROBIGA_AUTH_COOKIE_SECURE=
# 可选：首管理员注册窗口截止时间（ISO 8601，建议生产设置短时窗口）。
PROBIGA_AUTH_REGISTRATION_DEADLINE=

# Minute-reader MySQL pool.
MINUTE_MYSQL_POOL_SIZE=2
MINUTE_MYSQL_MAX_OVERFLOW=1
MINUTE_MYSQL_POOL_RECYCLE=1800

# Embedded scheduler.
API_EMBEDDED_SCHEDULER_ENABLED=false
API_QMT_LIVE_RUNTIME_ENABLED=false
API_SCHEDULER_MAX_CONCURRENT_TASKS=2
API_SCHEDULER_POLL_SECONDS=60

# Full-market QMT anomaly radar.  It is disabled by default because it reads
# the complete ordinary quote universe every polling interval.
MARKET_RADAR_ENABLED=false
MARKET_RADAR_POLL_SECONDS=5
MARKET_RADAR_TRADING_HOURS_ONLY=true
MARKET_RADAR_STOCK_LIMIT=0
MARKET_RADAR_BATCH_SIZE=500
MARKET_RADAR_QMT_TIMEOUT=120
MARKET_RADAR_SECTOR_LIMIT=500
MARKET_RADAR_MIN_SECTOR_MEMBERS=5
MARKET_RADAR_METADATA_REFRESH_SECONDS=900
MARKET_RADAR_EVENT_COOLDOWN_SECONDS=60
MARKET_RADAR_ALERT_ENABLED=false

# WeCom webhooks.
WECOM_WEBHOOK_URL=
WECOM_NEWS_WEBHOOK_URL=
WECOM_BRIEFING_WEBHOOK_URL=

# LLM provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Unified datasource registry.  These defaults do not depend on miniQMT.
# Stock/index history uses the existing adata path, index catalogs use Sina,
# and concepts use the existing Eastmoney path.
DATA_SOURCE_KLINE=adata
DATA_SOURCE_MINUTE=adata
DATA_SOURCE_CURRENT=adata
DATA_SOURCE_INDEX_KLINE=adata
DATA_SOURCE_INDEX_MINUTE=adata
DATA_SOURCE_INDEX_CURRENT=adata
DATA_SOURCE_CONCEPT_KLINE=east
DATA_SOURCE_CONCEPT_MINUTE=east
DATA_SOURCE_CONCEPT_CURRENT=east
DATA_SOURCE_CONCEPT_FLOW=east
DATA_SOURCE_CODE_LIST=adata
DATA_SOURCE_INDEX_LIST=sina
DATA_SOURCE_CONCEPT_LIST=east
DATA_SOURCE_FLOW_DAILY=adata
DATA_SOURCE_FLOW_MIN=adata
SI_ALL_CODE_SOURCE=adata
SI_ALL_INDEX_CODE_SOURCE=sina
SI_INDEX_CONSTITUENT_SOURCE=sina
SI_CONCEPT_SOURCE=east
SI_INDUSTRY_SOURCE=adata
# Legacy names still work:
# SM_STOCK_KLINE_SOURCE=adata
# SM_STOCK_MINUTE_SOURCE=adata
# SM_STOCK_CURRENT_SOURCE=adata
# SM_MARKET_DATA_SOURCE=

# MyQuant / Goldminer.
# GM_TOKEN=
# MYQUANT_PYTHON=
# MYQUANT_TIMEOUT=120

# JoinQuant / JQData.
JQ_PHONE=
JQ_PASSWORD=

# Standard desktop QMT primary quote bridge.  Import and start the generated
# probiga_big_qmt_bridge.py model in QMT; ProBigA consumes files from standard
# userdata/probiga_bridge.  This route never uses userdata_mini or xtquant.
BIG_QMT_BRIDGE_ENABLED=false
# BIG_QMT_HOME=D:\国金证券QMT交易端
BIG_QMT_FULL_REFRESH_SECONDS=30
BIG_QMT_TRACKED_FLUSH_SECONDS=1
BIG_QMT_FULL_BATCH_SIZE=800
BIG_QMT_SNAPSHOT_MAX_AGE_SECONDS=75
BIG_QMT_MIN_FULL_COVERAGE=0.95
BIG_QMT_WATCHLIST_REFRESH_SECONDS=30
# DATA_SOURCE_CURRENT=bigqmt

# Public-source live quote runtime.  Keep this off while Big QMT is primary;
# it remains available only as an operational fallback.
LIVE_QUOTE_POLL_ENABLED=false
LIVE_QUOTE_POLL_SECONDS=10
LIVE_QUOTE_IDLE_SLEEP_SECONDS=30
LIVE_QUOTE_TRADING_HOURS_ONLY=true
LIVE_QUOTE_CANDIDATE_LIMIT=60
LIVE_QUOTE_INDEX_POLL_SECONDS=60
SINA_CURRENT_TIMEOUT_SECONDS=8

# Legacy miniQMT integration is opt-in only.  Keep this disabled after moving
# current quotes to the standard desktop QMT bridge.
LEGACY_MINIQMT_ENABLED=false
QMT_CLIENT_AUTO_RESTART=false
QMT_CLIENT_MIN_BACKOFF_SECONDS=30
QMT_CLIENT_MAX_BACKOFF_SECONDS=900
BIG_QMT_RECOVERY_MIN_BACKOFF_SECONDS=30
BIG_QMT_RECOVERY_MAX_BACKOFF_SECONDS=900
# Optional; every retry/recovery is always written to data/qmt_health_alerts.jsonl.
QMT_ALERT_WEBHOOK_URL=
QMT_GATEWAY_ENABLED=0
QMT_GATEWAY_REQUIRED=0
# Guojin Securities QMT legacy SDK settings:
# GJ_QMT_HOME=D:\国金证券QMT交易端
# GJ_QMT_EXE=D:\国金证券QMT交易端\bin.x64\XtMiniQmt.exe
# GJ_QMT_PROVIDER_ID=gj_qmt
# QMT_PING_TIMEOUT=8
# Optional legacy QMT-primary switches (only when LEGACY_MINIQMT_ENABLED=true):
# DATA_SOURCE_KLINE=qmt
# DATA_SOURCE_MINUTE=qmt
# DATA_SOURCE_CURRENT=qmt
# DATA_SOURCE_INDEX_KLINE=qmt
# DATA_SOURCE_INDEX_MINUTE=qmt
# DATA_SOURCE_INDEX_CURRENT=qmt
# DATA_SOURCE_CODE_LIST=qmt
# DATA_SOURCE_INDEX_LIST=qmt
# DATA_SOURCE_CONCEPT_LIST=qmt
# SI_ALL_CODE_SOURCE=qmt
# SI_ALL_INDEX_CODE_SOURCE=qmt
# SI_INDEX_CONSTITUENT_SOURCE=qmt
# SI_CONCEPT_SOURCE=qmt
# SI_INDUSTRY_SOURCE=qmt
# Keep provider-specific concepts, announcements and QMT feature/L2 flow
# periods on their existing sources until their own entitlement probes pass.
# DATA_SOURCE_FLOW_DAILY=adata
# DATA_SOURCE_FLOW_MIN=adata
# Point this at the Python runtime that contains the SDK used by Guojin QMT.
# QMT_PYTHON=C:\path\to\QMT\python.exe
# QMT_SITE_PACKAGES=C:\path\to\QMT\Lib\site-packages
# XTQUANT_PATH=C:\path\to\QMT\Lib\site-packages\xtquant
# Production Linux consumes the loopback QMT gateway through the reverse SSH
# tunnel maintained by tools/run_remote_qmt_tunnel.py on the Windows QMT host.
# QMT_GATEWAY_ENABLED=1
# QMT_GATEWAY_REQUIRED=1
# QMT_GATEWAY_URL=http://127.0.0.1:18765
# QMT_GATEWAY_REQUEST_TIMEOUT=60
# Optional tuning:
# QMT_DIVIDEND_TYPE=none
# QMT_TIMEOUT=600
# Keep live quote polling separate from long historical-data requests.
# QMT_CURRENT_TIMEOUT=15
# QMT_FLOW_MIN_TIMEOUT=30
# QMT_CONCEPT_CURRENT_BATCH_SIZE=60
# QMT_CONCEPT_MINUTE_BATCH_SIZE=60
# QMT_CONCEPT_KLINE_BATCH_SIZE=60
# QMT_FLOW_DOWNLOAD_HISTORY=0
# QMT_KLINE_BATCH_SIZE=300
# QMT_MINUTE_BATCH_SIZE=200
# QMT_CURRENT_BATCH_SIZE=500
# QMT_PRODUCTION_KLINE_BATCH_SIZE=200
# QMT_PRODUCTION_MINUTE_BATCH_SIZE=200
# BIG_QMT_MINUTE_BATCH_SIZE=200
# QMT_PRODUCTION_INDEX_KLINE_BATCH_SIZE=40
# QMT_PRODUCTION_INDEX_MINUTE_BATCH_SIZE=40
# QMT_MINUTE_DB_CHUNK_SIZE=1000
# QMT_INDEX_DB_CHUNK_SIZE=1000
# QMT_CURRENT_MIN_COVERAGE=0.98
# CURRENT_MIN_COVERAGE=0.98
# QMT_CURRENT_MAX_AGE_SECONDS=180
# QMT_KLINE_MIN_COVERAGE=0.90
# QMT_MINUTE_MIN_COVERAGE=0.85
# QMT_LIVE_POLL_ENABLED=true
# QMT_LIVE_POLL_SECONDS=5
# QMT_LIVE_IDLE_SLEEP_SECONDS=30
# QMT_LIVE_TRADING_HOURS_ONLY=true
# QMT_LIVE_CANDIDATE_LIMIT=60

# Website -> local Codex/DeepSeek bridge. Generate a long random value and use
# the same secret on production and on the Windows bridge host.
PROBIGA_AI_BRIDGE_TOKEN=
PROBIGA_AI_BRIDGE_LEASE_SECONDS=900
# PROBIGA_AI_BRIDGE_SERVER_URL=http://47.113.123.190
# PROBIGA_CODEX_STOCK_THREAD_ID=019fbe02-0390-7663-a7ba-bd150e063fe7
# PROBIGA_CODEX_GENERAL_THREAD_ID=019fbe02-0a70-7c62-9bf2-9ab439bea770
# PROBIGA_CODEX_TIMEOUT_SECONDS=240

# Keep the web process unable to mutate Git or deploy hosts.  Production must
# use the reviewed CI workflow; enable only for a deliberately isolated admin
# workstation that is allowed to push an already-clean main commit.
PROBIGA_IN_APP_DEPLOY_ENABLED=0
PROBIGA_DEPLOYMENT_MODE=development
# Emergency-only manual upload remains fail-closed unless all three are set
# deliberately; normal production delivery must leave them unset/disabled.
# Manual code upload is permanently disabled; production deploys use pinned CI.
PROBIGA_MANUAL_PRODUCTION_DEPLOY_ENABLED=0
# PROBIGA_SSH_KNOWN_HOSTS=C:\Users\you\.ssh\known_hosts
PROBIGA_ALLOW_ROOT_PRODUCTION_DEPLOY=0
