# Copy to `.env` and fill in the values you actually use.
# Do not commit secrets.

# Primary MySQL connection used by data jobs and the API.
# Example:
# MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/probiga?charset=utf8mb4
MYSQL_URL=

# Optional: stock-minute history can live in another MySQL instance.
# Example:
# MINUTE_MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:13306/probiga?charset=utf8mb4
# QMT history is bigger; point this to a local/off-production MySQL database.
# QMT_HISTORY_MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:13306/probiga_qmt_history?charset=utf8mb4
# MINUTE_DATA_SOURCE=gm
# MINUTE_STOCK_TABLE=sm_stock_minute_gm
QMT_HISTORY_MYSQL_URL=
MINUTE_MYSQL_URL=
MINUTE_DATA_SOURCE=legacy
MINUTE_STOCK_TABLE=

# Legacy fallback if MYSQL_URL is unset.
DATABASE_URL=

# API MySQL pool.
API_MYSQL_POOL_SIZE=3
API_MYSQL_MAX_OVERFLOW=1
API_MYSQL_POOL_RECYCLE=1800

# Minute-reader MySQL pool.
MINUTE_MYSQL_POOL_SIZE=2
MINUTE_MYSQL_MAX_OVERFLOW=1
MINUTE_MYSQL_POOL_RECYCLE=1800

# Embedded scheduler.
API_EMBEDDED_SCHEDULER_ENABLED=false
API_SCHEDULER_MAX_CONCURRENT_TASKS=1
API_SCHEDULER_POLL_SECONDS=60

# WeCom webhooks.
WECOM_WEBHOOK_URL=
WECOM_NEWS_WEBHOOK_URL=
WECOM_BRIEFING_WEBHOOK_URL=

# LLM provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Unified datasource registry.
# Supported values: adata, akshare, myquant, qmt
# New names:
# DATA_SOURCE_KLINE=adata
# DATA_SOURCE_MINUTE=adata
# DATA_SOURCE_CURRENT=adata
# Legacy names still work:
# SM_STOCK_KLINE_SOURCE=adata
# SM_STOCK_MINUTE_SOURCE=adata
# SM_STOCK_CURRENT_SOURCE=adata
# SM_MARKET_DATA_SOURCE=

# MyQuant / Goldminer.
# GM_TOKEN=
# MYQUANT_PYTHON=
# MYQUANT_TIMEOUT=120

# JoinQuant / JQData.
JQ_PHONE=
JQ_PASSWORD=

# Guojin Securities QMT. `xtquant` is the module name of the official
# native-Python SDK; the business datasource id remains `gj_qmt`.
# Start and log into the Guojin QMT client first, then run miniQMT mode.
# GJ_QMT_HOME=D:\国金证券QMT交易端
# GJ_QMT_EXE=D:\国金证券QMT交易端\bin.x64\XtMiniQmt.exe
# GJ_QMT_PROVIDER_ID=gj_qmt
# QMT_PING_TIMEOUT=8
# Recommended switch:
# DATA_SOURCE_KLINE=qmt
# DATA_SOURCE_MINUTE=qmt
# DATA_SOURCE_CURRENT=qmt
# DATA_SOURCE_INDEX_KLINE=qmt
# DATA_SOURCE_INDEX_MINUTE=qmt
# DATA_SOURCE_INDEX_CURRENT=qmt
# DATA_SOURCE_CONCEPT_KLINE=qmt
# DATA_SOURCE_CONCEPT_MINUTE=qmt
# DATA_SOURCE_CONCEPT_CURRENT=qmt
# DATA_SOURCE_CONCEPT_FLOW=qmt
# DATA_SOURCE_CODE_LIST=qmt
# DATA_SOURCE_INDEX_LIST=qmt
# DATA_SOURCE_CONCEPT_LIST=qmt
# DATA_SOURCE_FLOW_DAILY=qmt
# DATA_SOURCE_FLOW_MIN=qmt
# SI_ALL_CODE_SOURCE=qmt
# SI_ALL_INDEX_CODE_SOURCE=qmt
# SI_INDEX_CONSTITUENT_SOURCE=qmt
# SI_CONCEPT_SOURCE=qmt
# SI_INDUSTRY_SOURCE=qmt
# MINUTE_DATA_SOURCE=qmt
# Point this at the Python runtime that contains the SDK used by Guojin QMT.
# QMT_PYTHON=C:\path\to\QMT\python.exe
# QMT_SITE_PACKAGES=C:\path\to\QMT\Lib\site-packages
# XTQUANT_PATH=C:\path\to\QMT\Lib\site-packages\xtquant
# Optional tuning:
# QMT_DIVIDEND_TYPE=none
# QMT_TIMEOUT=600
# QMT_CONCEPT_CURRENT_BATCH_SIZE=60
# QMT_CONCEPT_MINUTE_BATCH_SIZE=60
# QMT_CONCEPT_KLINE_BATCH_SIZE=60
# QMT_FLOW_DOWNLOAD_HISTORY=0
# QMT_KLINE_BATCH_SIZE=300
# QMT_MINUTE_BATCH_SIZE=200
# QMT_CURRENT_BATCH_SIZE=500
# QMT_LIVE_POLL_ENABLED=true
# QMT_LIVE_POLL_SECONDS=5
# QMT_LIVE_IDLE_SLEEP_SECONDS=30
# QMT_LIVE_TRADING_HOURS_ONLY=true
# QMT_LIVE_CANDIDATE_LIMIT=60
