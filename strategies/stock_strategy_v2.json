  "shared_formulas": {
    "long_term_score": {
      "expression": "clamp(fundamental_score*0.34 + growth_score*0.28 + valuation_score*0.20 + risk_score*0.18)",
      "weights": {
        "fundamental_score": 0.34,
        "growth_score": 0.28,
        "valuation_score": 0.20,
        "risk_score": 0.18
      }
    },
    "short_term_score": {
      "expression": "clamp(technical_score*0.34 + capital_score*0.28 + sentiment_score*0.24 + event_score*0.14)",
      "weights": {
        "technical_score": 0.34,
        "capital_score": 0.28,
        "sentiment_score": 0.24,
        "event_score": 0.14
      }
    },
    "ai_score": {
      "expression": "clamp(short_term_score*0.58 + long_term_score*0.42)",
      "weights": {
        "short_term_score": 0.58,
        "long_term_score": 0.42
      }
    },
    "entry_score": {
      "expression": "clamp(chase_score*0.28 + expected_return_score*0.26 + heat_overload_score*0.16 + liquidity_score*0.12 + sector_rotation_score*0.10 + chip_capital_score*0.08 + confidence_score*0.04 + leadership_adjustment)",
