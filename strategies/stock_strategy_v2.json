        "chase_score": 0.28,
        "expected_return_score": 0.26,
        "heat_overload_score": 0.16,
        "liquidity_score": 0.12,
        "sector_rotation_score": 0.10,
        "chip_capital_score": 0.08,
        "confidence_score": 0.04
      },
      "leadership_adjustment": {
        "leader": 3.0,
        "front": 1.5,
        "middle": 0.0,
        "follower": -2.0
      }
    },
    "final_trade_score": {
      "expression": "clamp(quality_score*0.70 + entry_score*0.30)",
      "weights": {
        "quality_score": 0.70,
        "entry_score": 0.30
      }
    }
